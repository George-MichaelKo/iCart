# Explicit local-development credentials; never use these in a public deployment.
# The CLI reads process environment variables; it does not automatically load this file.
ICART_DATABASE_URL=postgresql://icart:icart_local_only@127.0.0.1:55432/icart
# Tests require a separate database named exactly icart_test.
ICART_TEST_DATABASE_URL=postgresql://icart:icart_local_only@127.0.0.1:55432/icart_test
